<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="bg">#FFFAF6</color>
    <color name="red">#E53935</color>
    <color name="red_dark">#B71C1C</color>
    <color name="red_ring">#FFCDD2</color>

    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorAccent">@color/red</item>
        <item name="android:colorPrimary">@color/red</item>
        <item name="android:colorPrimaryDark">@color/red_dark</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
    </style>
    <style name="Label">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:textColor">#444444</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Field">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">20sp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="Action" parent="android:Widget.Material.Button.Colored">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
